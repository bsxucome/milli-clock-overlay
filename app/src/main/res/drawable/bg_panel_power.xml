<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <selector>
            <item android:state_selected="true">
                <shape android:shape="oval">
                    <gradient android:angle="315"
                        android:startColor="@color/home_ring_running_highlight"
                        android:centerColor="@color/home_ring_running_mid"
                        android:endColor="@color/home_ring_running_edge" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <gradient android:angle="315"
                        android:startColor="@color/window_background"
                        android:centerColor="@color/home_ring_idle_mid"
                        android:endColor="@color/home_ring_idle_edge" />
                    <stroke android:width="1dp" android:color="@color/home_section_divider" />
                </shape>
            </item>
        </selector>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="@color/window_background" />
        </shape>
    </item>
    <item android:width="21dp" android:height="21dp" android:gravity="center"
        android:drawable="@drawable/ic_panel_power" />
</layer-list>
